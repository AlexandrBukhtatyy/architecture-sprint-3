@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

!$domains_root_path = ../.

!define _actors $domains_root_path/_shared/actors
!define _systems $domains_root_path/_shared/systems
!define _containers $domains_root_path/_shared/containers
!define _external_systems $domains_root_path/_shared/external-systems

skinparam wrapWidth 1200

LAYOUT_WITH_LEGEND()
LAYOUT_LANDSCAPE()
title
    <b>"Warm Home" PublicationArch v2022.05.26</b>
    <i>SaaS платформа по управлению умным домом</i>
end title

' skinparam linetype polyline
' skinparam linetype ortho

!include _actors/persons.iuml!client

System_Boundary(warm_house, "SaaS-платформа увправления умным домом") {
    !include _containers/containers.iuml!web_app
    !include _containers/containers.iuml!api_gateway
    !include _containers/containers.iuml!house_monitoring
    !include _containers/containers.iuml!house_monitoring_database
    !include _containers/containers.iuml!house_managment
    !include _containers/containers.iuml!house_managment_database
    !include _containers/containers.iuml!command_executor
    !include _containers/containers.iuml!house_event_broker

    Rel(web_app, api_gateway, "Отправляет запросы", "HTTPS")
    
    Rel(api_gateway, house_monitoring, "Перенаправляет запросы", "HTTPS")
    Rel_D(house_monitoring, house_monitoring_database, "Сохраняет данные", "HTTPS")
    Rel(house_monitoring, house_event_broker, "Отправляет/Получает события", "HTTPS")

    Rel(api_gateway, house_managment, "Перенаправляет запросы", "HTTPS")
    Rel_D(house_managment, house_managment_database, "Сохраняет данные", "HTTPS")
    Rel(house_managment, house_event_broker, "Отправляет/Получает события", "HTTPS")
}

System_Boundary(client_house, "Устройства в доме") {
    !include _external_systems/devices.iuml!smart_device
    !include _external_systems/devices.iuml!rele
    !include _external_systems/devices.iuml!sensor
    !include _external_systems/devices.iuml!heater

    Lay_L(smart_device, rele)
    Lay_L(rele, sensor)
    Lay_L(sensor, heater)
}

Rel(client, web_app, "Управляет умным домом", "HTTPS")
Rel_D(command_executor, house_event_broker, "Отправляет/Получает события")
Rel(command_executor, client_house, "Отправляет команды")
Rel(client_house, command_executor, "Отправляет результаты команд")

@enduml
